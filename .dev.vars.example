# 复制为 .dev.vars（本地）；生产用 `wrangler secret put <NAME>` 写入
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_SECRET=
# Waffo Pancake（默认支付）
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# Dodo Payments（可选）
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# fal.ai 视频生成
FAL_KEY=
# yir.ai 视频网关（VIDEO_PROVIDER=yir 时必填）
YIR_API_KEY=
# KIE.ai（VIDEO_PROVIDER=kie 时必填）
KIE_API_KEY=
# 图片审核（MODERATION_PROVIDER=openai 时必填）
OPENAI_API_KEY=
# Turnstile（vars.TURNSTILE_SITE_KEY 非空时必填）
TURNSTILE_SECRET_KEY=
# 付款即时通知（可选）：Telegram / 飞书 / Discord / Slack 的 webhook 地址，见 docs/env.md
PAYMENT_NOTIFY_WEBHOOK_URL=
